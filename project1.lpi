<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="project1"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <Units>
      <Unit>
        <Filename Value="project1.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="analizadorlexico.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="analizadorLexico"/>
      </Unit>
      <Unit>
        <Filename Value="analizadorsintactico.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="analizadorSintactico"/>
      </Unit>
      <Unit>
        <Filename Value="tipos.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Tipos"/>
      </Unit>
      <Unit>
        <Filename Value="unittas.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UnitTAS"/>
      </Unit>
      <Unit>
        <Filename Value="manejopilas.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="ManejoPilas"/>
      </Unit>
      <Unit>
        <Filename Value="manejoestado.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="ManejoEstado"/>
      </Unit>
      <Unit>
        <Filename Value="evaluador.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Evaluador"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="project1"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
